@model InventarioPaldaca.Models.ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<h1>@Model.ErrorType</h1>

<p>@Model.UserFriendlyMessage</p>

@if (Model.ShowRequestId)
{
    <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
}

@if (Model.ShowDetailedMessage)
{
    <h4>Detalles del error:</h4>
    <pre>@Model.Message</pre>
}

@if (!string.IsNullOrEmpty(Model.ExceptionDetails))
{
    <h4>Detalles técnicos:</h4>
    <pre>@Model.ExceptionDetails</pre>
}
