<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Inventario Paldaca</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.21/jspdf.plugin.autotable.min.js"></script>
    <link rel="icon" type="image/x-icon" href="~/img/Paldaca Icon.png">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/normalize.css" asp-append-version="true" />
  
    @RenderSection("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="bg-opacity-10 bgcolor text-white py-3 px-4">
        <div class="container d-flex justify-content-between align-items-center">
            <nav class="d-flex align-items-center">
                <button class="navbar-toggler d-md-none btn-outline-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-md-flex justify-content-md-end" id="navbarNav">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="text-white text-decoration-none me-4">Inicio</a>
                    <a asp-area="" asp-controller="Activo" asp-action="Index" class="text-white text-decoration-none me-4">Activos</a>
                    <a asp-area="" asp-controller="Usuario" asp-action="Index" class="text-white text-decoration-none me-4">Usuarios</a>
                    <a asp-area="" asp-controller="Proveedor" asp-action="Index" class="text-white text-decoration-none me-4">Proveedores</a>
                    <a asp-area="" asp-controller="Mantenimientos" asp-action="ActivosEnMantenimiento" class="text-white text-decoration-none me-4">Mantenimiento</a>
                    <a asp-area="" asp-controller="Proyectos" asp-action="ListadoProyectos" class="text-white text-decoration-none me-4">Proyectos</a>
                </div>
            </nav>
            <div class="ms-auto">
                @if (Context.Session.GetString("UsuarioId") != null)
                {
                    <form asp-controller="Acceso" asp-action="Logout" method="post">
              
                        <button class="btnlogout">
                            <div class="sign">
                                <svg viewBox="0 0 512 512">
                                    <path d="M377.9 105.9L500.7 228.7c7.2 7.2 11.3 17.1 11.3 27.3s-4.1 20.1-11.3 27.3L377.9 406.1c-6.4 6.4-15 9.9-24 9.9c-18.7 0-33.9-15.2-33.9-33.9l0-62.1-128 0c-17.7 0-32-14.3-32-32l0-64c0-17.7 14.3-32 32-32l128 0 0-62.1c0-18.7 15.2-33.9 33.9-33.9c9 0 17.6 3.6 24 9.9zM160 96L96 96c-17.7 0-32 14.3-32 32l0 256c0 17.7 14.3 32 32 32l64 0c17.7 0 32 14.3 32 32s-14.3 32-32 32l-64 0c-53 0-96-43-96-96L0 128C0 75 43 32 96 32l64 0c17.7 0 32 14.3 32 32s-14.3 32-32 32z"></path>
                                </svg>
                            </div>
                            <div class="text">Logout</div>
                        </button>

                    </form>
                }
            </div>
        </div>
    </header>
    <div class="headercontainer">  
        <a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none d-flex align-items-center">
            <img src="~/img/paldaca_logo-header-2.png" class="logoheader" />
        </a>
    </div>
    <main class="flex-fill py-5 mb-5">
        <div class="container">
            @RenderBody()
        </div>
    </main>
    <footer class="text-white py-3 border-top footer mt-4 bgcolor">
        <div class="container d-flex justify-content-between align-items-center">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="headercontainer">
                <img src="~/img/paldaca_logo-header-2.png" />
            </a>
            <nav class="d-md-flex bg-opacity-50">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="text-white text-decoration-none me-4">Inicio</a>
                <a asp-area="" asp-controller="Activo" asp-action="Index" class="text-white text-decoration-none me-4">Activos</a>
                <a asp-area="" asp-controller="Usuario" asp-action="Index" class="text-white text-decoration-none me-4">Usuarios</a>
                <a asp-area="" asp-controller="Proveedor" asp-action="Index" class="text-white text-decoration-none m me-4">Proveedores</a>
                <a href="https://paldaca.com/" class="text-white text-decoration-none me-4">Contact</a>
            </nav>
        </div>
    </footer>
    @RenderSection("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
