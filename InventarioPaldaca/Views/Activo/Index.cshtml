@model InventarioPaldaca.Models.ViewModels.ListaActivosViewModel

<div class="container my-5 form-container" id="top">
    <h1 class="form-title">
        <img src="/img/Iconos/activos.svg" alt="Icono Activos" style="width: 32px; height: 32px; margin-right: 10px;">
        Activos
    </h1>
    <hr class="linea" style="color: #32407b" />

    <!-- Botones de acciones -->
    <div class="row text-center g-2 mb-4">
        <div class="col">
            <a asp-action="Create" class="btn btn-action btn-sm w-100">Nuevo Activo</a>
        </div>
        <div class="col">
            <button id="toggleDelete" class="btn w-100 btn-action">
                Eliminar activos
            </button>
        </div>
        <div class="col">
            <button id="generatePdfBtn" class="btn btn-action btn-sm w-100">
                Generar Informe
            </button>
        </div>
        <div class="col">
            <button id="openReassignModalBtn" class="btn btn-action btn-sm w-100">
                Reasignar activos
            </button>
        </div>
        <div class="col">
            <button id="relocalizarBtn" class="btn btn-action btn-sm w-100" data-bs-toggle="modal" data-bs-target="#relocalizarModal">
                Reubicar activos
            </button>
        </div>
    </div>
    <!-- Filtros -->
    <div class="filter-container mb-4">
        <h5 class="form-title" style="font-size: 20px;">
            <img src="/img/Iconos/filtrar.svg" alt="Icono Activos" style="width: 32px; height: 32px; margin-right: 10px;">
            Filtrar activos
        </h5>
        <form id="filterForm">
            <div class="row">
                <!-- Primera fila con Categoría Maestra ocupando toda la fila -->
                <div class="col-md-12">
                    <label for="categoriaMaster" class="form-label">Categoría Maestra:</label>
                    <select class="form-select" id="categoriaMaster" onchange="filtrarActivos()">
                        <option value="">Seleccione una Categoría</option>
                        @foreach (var categoriaMaster in Model.CategoriasMaster)
                        {
                            <option value="@categoriaMaster.Nombre">@categoriaMaster.Nombre</option>
                        }
                    </select>
                </div>

                <!-- Segunda fila con Categoría y Ubicación ocupando la mitad cada una -->
                <div class="col-md-6 mt-3">
                    <label for="categoria" class="form-label">Categoría:</label>
                    <select class="form-select" id="categoria" onchange="filtrarActivos()">
                        <option value="">Seleccione una sub-categoría</option>
                        @foreach (var categoria in Model.Categorias)
                        {
                            <option value="@categoria.CategoriaNombre">@categoria.CategoriaNombre</option>
                        }
                    </select>
                </div>

                <div class="col-md-6 mt-3">
                    <label for="ubicacion" class="form-label">Ubicación:</label>
                    <select class="form-select" id="ubicacion" onchange="filtrarActivos()">
                        <option value="">Seleccione una ubicación</option>
                        @foreach (var ubicacion in Model.Ubicaciones)
                        {
                            <option value="@ubicacion.UbicacionNombre">@ubicacion.UbicacionNombre</option>
                        }
                    </select>
                </div>
                <!-- Tercera fila: Código Inventario y Proyecto -->
                <div class="col-md-6 mt-3">
                    <label for="codigoInventario" class="form-label">Código de Inventario:</label>
                    <input type="text" class="form-control" id="codigoInventario" placeholder="Ingrese el código de inventario" onkeyup="filtrarActivos()">
                </div>

                <div class="col-md-6 mt-3">
                    <label for="proyecto" class="form-label">Proyecto:</label>
                    <select class="form-select" id="proyecto" onchange="filtrarActivos()">
                        <option value="0">Seleccione un proyecto</option>
                        @foreach (var proyecto in Model.Proyectos)
                        {
                            <option value="@proyecto.ProyectoId">@proyecto.Nombre</option>
                        }
                    </select>
                </div>
            </div>
        </form>
    </div>

    <div id="contenedorTablaPaginada">
        <partial name="_PaginacionActivosPartial" model="Model" />
    </div>

    <hr class="linea" />

    <!-- Modal para reasignar usuario y proyecto -->
    <div class="modal fade" id="reassignModal" tabindex="-1" role="dialog" aria-labelledby="reassignModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="reassignModalLabel">Reasignar activo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <form id="reassignForm" asp-action="ReasignarActivo" method="post" onsubmit="return confirm('¿Estás seguro de realizar la reasignación?');">
                        <div class="form-group mb-3">
                            <label for="activoId">Seleccione un activo:</label>
                            <select id="activoId" name="id" class="form-control" required>
                                @foreach (var activo in Model.ActivosDisponiblesParaReasignar)
                                {
                                    <option value="@activo.ActivoId">
                                        @activo.CodigoInventario - @activo.Modelo - @activo.Categoria.CategoriaNombre - @(activo.Usuario?.UsuarioNombre ?? "No asignado")
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="form-group mb-3">
                            <label for="usuarioId">Nuevo usuario</label>
                            <select id="usuarioId" name="usuarioId" class="form-control">
                                <option value="default">-- Seleccione un usuario --</option>
                                @foreach (var usuario in ViewBag.Usuarios)
                                {
                                    <option value="@usuario.Value">@usuario.Text</option>
                                }
                            </select>
                        </div>

                        <div class="form-group mb-3">
                            <label for="proyectoId">Nuevo proyecto</label>
                            <select id="proyectoId" name="proyectoId" class="form-control">
                                <option value="default">-- Seleccione un proyecto --</option>
                                <option value="">-- Sin Proyecto --</option>
                                @foreach (var proyecto in ViewBag.Proyectos)
                                {
                                    <option value="@proyecto.Value">@proyecto.Text</option>
                                }
                            </select>
                        </div>

                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Reasignar</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>


    <!-- Modal para reubicar activos -->
    <div class="modal fade" id="relocalizarModal" tabindex="-1" role="dialog" aria-labelledby="relocalizarModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="relocalizarModalLabel">Relocalizar activo</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="relocalizarForm" asp-action="RelocalizarActivo" method="post">
                        <div class="form-group">
                            <label for="activoId">Seleccione un activo:</label>
                            <select id="activoId" name="id" class="form-control">
                                @foreach (var activo in Model.ListaActivosCompleta)
                                {
                                    <option value="@activo.ActivoId">@activo.CodigoInventario - @activo.Modelo - @activo.Categoria.CategoriaNombre - @(activo.Usuario?.UsuarioNombre ?? "No asignado")</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="ubicacionId">Seleccione una nueva ubicación:</label>
                            <select id="ubicacionId" name="ubicacionId" class="form-control">
                                @foreach (var ubicacion in Model.Ubicaciones)
                                {
                                    <option value="@ubicacion.UbicacionId">@ubicacion.UbicacionNombre</option>
                                }
                            </select>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                            <button type="submit" class="btn btn-primary">Relocalizar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- Total activos -->
    <div class="total-container container mt-4">
        <div class="row text-center">

            <!-- Total de Activos -->
            <div class="col-md-4 mb-3">
                <div class="info-card">
                    <h5>Total de Activos</h5>
                    <p class="display-6">@Model.TotalActivos</p>
                </div>
            </div>

            <!-- Activos por Categoría -->
            <div class="col-md-4 mb-3">
                <div class="info-card">
                    <h5>Activos por Categoría</h5>
                    <ul class="list-unstyled">
                        @foreach (var categoria in Model.ActivosPorCategoria)
                        {
                            var nombreCategoria = categoria.Key.ToLower();
                            var iconoEntry = Model.IconosPorCategoria
                            .FirstOrDefault(x => nombreCategoria.Contains(x.Key.ToLower()));
                            var Icono = iconoEntry.Value;

                            <li>
                                @if (!string.IsNullOrEmpty(Icono))
                                {
                                    <img src="@Icono" width="20" height="20" class="me-1" />
                                }
                                @categoria.Key: @categoria.Value
                            </li>
                        }
                    </ul> 
                    <div class="col">
                        <a asp-action="Create" asp-controller="Categoria" class="btn btn-action btn-sm w-100">Nueva Categoria</a>
                    </div>
                </div>
            </div>


            <!-- Activos por Ubicación -->
            <div class="col-md-4 mb-3">
                <div class="info-card">
                    <h5>
                        <img src="/img/Iconos/nueva_ubicacion.svg" alt="Icono Ubicación" style="width: 30px; height: 30px; margin-right: 6px; vertical-align: middle;">
                        Activos por Ubicación
                    </h5>
                    <ul class="list-unstyled">
                        @foreach (var ubicacion in Model.ActivosPorUbicacion)
                        {
                            <li>
                                <img src="/img/Iconos/nueva_ubicacion.svg" alt="Icono Ubicación" style="width: 25px; height: 25px; margin-right: 6px; vertical-align: middle;">
                                @ubicacion.Key: @ubicacion.Value
                            </li>
                        }
                    </ul>
                    <a asp-action="Create" asp-controller="Ubicacion"
                       class="btn btn-sm btn-action w-100 mt-2">
                        Nueva Ubicación
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<a class="ToTop mb-5 mt-3" href="#top">
    <svg class="svgIcon" viewBox="0 0 384 512">
        <path d="M214.6 41.4c-12.5-12.5-32.8-12.5-45.3 0l-160 160c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3
              0L160 141.2V448c0 17.7 14.3 32 32 32s32-14.3 32-32V141.2L329.4 246.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3l-160-160z">
        </path>
    </svg>
</a>

@section Scripts {
    <script>

           function asignarEventosFila() {
            document.querySelectorAll('.clickable-row').forEach(row => {
                row.addEventListener('click', function (event) {
                    const target = event.target;

                    // Ignorar clics dentro de botones, formularios, modales
                    if (target.closest('button') || target.closest('form') || target.closest('.modal')) {
                        return;
                    }

                    // Si clic en nombre o apellido (ir al perfil)
                    if (target.classList.contains('perfil-link')) {
                        const perfilUrl = row.dataset.userUrl;
                        if (perfilUrl) {
                            window.location.href = perfilUrl;
                        }
                    } else {
                        // Si clic en cualquier otra parte (ir al historial)
                        const historialUrl = row.dataset.historialUrl;
                        if (historialUrl) {
                            window.location.href = historialUrl;
                        }
                    }
                });
            });
        }

        // IMPORTANTE: Llama esto después de cualquier carga AJAX
        function cargarPagina(pagina) {
            var categoria = $('#categoria').val();
            var ubicacion = $('#ubicacion').val();
            var codigoInventario = $('#codigoInventario').val();
            var categoriaMaster = $('#categoriaMaster').val();

            $.ajax({
                url: '@Url.Action("FiltrarActivos", "Activo")',
                type: 'GET',
                data: {
                    categoria: categoria,
                    ubicacion: ubicacion,
                    codigoInventario: codigoInventario,
                    categoriaMaster: categoriaMaster,
                    pagina: pagina,
                    pageSize: 10
                },
                success: function (result) {
                    $('#contenedorTablaPaginada').html(result);
                    asignarEventosFila();
                },
                error: function (xhr, status, error) {
                    alert('Error al cambiar de página: ' + error);
                }
            });
        }

           
        $(document).ready(function () {

                 asignarEventosFila();
            // Función para generar y guardar el PDF
            $('#generatePdfBtn').click(generatePDF);

            $('#openReassignModalBtn').click(function () {
                $('#reassignModal').modal('show');
            });
        
            $('#toggleDelete').click(function () {
                // Alternar la visibilidad de la columna de eliminación
                $('.delete-column').toggle();
            });

            document.getElementById("activoId").addEventListener("change", function () {
            document.getElementById("liberarActivoId").value = this.value;
            });

            $('#categoriaMaster').change(function () {
                var categoriaMaster = $(this).val();
                var $categoriaSelect = $('#categoria');
                $categoriaSelect.empty(); // Limpiar opciones anteriores
                $categoriaSelect.append('<option value="">Seleccione una sub-categoría</option>');

                // Solo hacer la solicitud AJAX si se ha seleccionado una categoría maestra válida
                if (categoriaMaster) {
                    $.ajax({
                        url: '@Url.Action("ObtenerSubcategorias", "Activo")',
                        type: 'GET',
                        data: { categoriaMaster: categoriaMaster },
                        success: function (subcategorias) {

                            // Agregar nuevas opciones
                            $.each(subcategorias, function (index, subcategoria) {
                                if (subcategoria.categoriaNombre) { // Asegurarse de que el campo no sea undefined
                                    $categoriaSelect.append('<option value="' + subcategoria.categoriaNombre + '">' + subcategoria.categoriaNombre + '</option>');
                                }
                            });
                        },
                        error: function (xhr, status, error) {
                            alert('Ocurrió un error al obtener las subcategorías: ' + error);
                        }
                    });
                }
            });

            // Manejar los cambios en los campos de filtro
            $('#filterForm select, #filterForm input').on('change', function () {
                filtrarActivos();
            });

            let sortOrder = 'desc';

            $('#sortByName').click(function (e) {
                e.preventDefault();
                sortOrder = (sortOrder === 'asc') ? 'desc' : 'asc';

                $.ajax({
                    url: '@Url.Action("OrdenarPorNombre", "Activo")',
                    type: 'GET',
                    data: { sortOrder: sortOrder },
                    success: function (result) {
                        $('#activosTableBody').html(result);
                    },
                    error: function (xhr, status, error) {
                        alert('Ocurrió un error al ordenar los activos: ' + error);
                    }
                });
            });

                         function filtrarActivos(categoriaMaster = '') {
            var categoria = $('#categoria').val();
            var ubicacion = $('#ubicacion').val();
            var codigoInventario = $('#codigoInventario').val();
            var proyectoId = $('#proyecto').val(); // nuevo select

            $.ajax({
                url: '@Url.Action("FiltrarActivos", "Activo")',
                type: 'GET',
                data: {
                    categoria: categoria,
                    ubicacion: ubicacion,
                    codigoInventario: codigoInventario,
                    categoriaMaster: categoriaMaster,
                    proyectoId: proyectoId // incluir proyectoId en el GET
                },
                success: function (result) {
                    $('#contenedorTablaPaginada').html(result);
                    asignarEventosFila(); // reactiva eventos en la tabla
                },
                error: function (xhr, status, error) {
                    alert('Ocurrió un error al filtrar los activos: ' + error);
                }
            });
        }


        });

        async function generatePDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('portrait', 'mm', 'a4');

            // Ruta de la imagen en el servidor
            const logoUrl = '/img/Paldaca logoyRif.png';

            async function getBase64ImageFromUrl(url) {
                const response = await fetch(url);
                const blob = await response.blob();
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onloadend = () => resolve(reader.result);
                    reader.onerror = () => reject(new Error('Error al cargar la imagen'));
                    reader.readAsDataURL(blob);
                });
            }

            try {
                const logoBase64 = await getBase64ImageFromUrl(logoUrl);
                doc.addImage(logoBase64, 'PNG', 14, 10, 40, 15);
            } catch (error) {
                console.error('Error al cargar el logo:', error);
            }
                 const today = new Date();
            const formattedDate = today.toLocaleDateString('es-VE', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
            });

            // Encabezado tabla del título
            doc.autoTable({
                startY: 10,
                margin: { left: 60, right: 40 },
                tableWidth: 140,
                theme: 'plain',
                body: [
                    [{ content: 'SISTEMA DE GESTIÓN DE LA CALIDAD', styles: { halign: 'center', fontSize: 10 } }],
                    [{ content: 'SISTEMAS Y TECNOLOGÍA', styles: { halign: 'center', fontSize: 10 } }],
                    [{ content: 'CONTROL DE INVENTARIO', styles: { halign: 'center', fontSize: 12, fontStyle: 'bold' } }]
                ],
                styles: {
                    cellPadding: 2,
                    textColor: [0, 0, 0],
                    lineColor: [0, 0, 0],
                    lineWidth: 0.5,
                    font: 'helvetica',
                },
                showHead: false,
            });

            // Agregar la fecha de emisión justo debajo del encabezado
            doc.setFontSize(10);
            doc.text(`Fecha de emisión: ${formattedDate}`, 14, doc.lastAutoTable.finalY + 5);
            doc.setLineWidth(0.5);
            doc.line(14, 52, 196, 52);

            // Obtener la tabla HTML
            const table = document.querySelector('#activosTable');
            if (!table) {
                alert('No se encontró la tabla #activosTable');
                return;
            }

            // Obtener encabezados (th)
            const headers = Array.from(table.querySelectorAll('thead tr th'));

            // Filtrar para eliminar columnas 8 y 9 (índices 7 y 8)
            const filteredHeaders = headers.filter((_, index) => index !== 8 && index !== 9);

            // Preparar array de encabezados para autoTable
            const head = [filteredHeaders.map(th => th.textContent.trim())];

            // Obtener todas las filas de tbody
            const rows = Array.from(table.querySelectorAll('tbody tr'));

            // Preparar body filtrando las columnas 8 y 9
            const body = rows.map(row => {
                const cells = Array.from(row.querySelectorAll('td'));
                // Filtramos las columnas 7 y 8 para excluir funcionalidad y eliminar
                const filteredCells = cells.filter((_, index) => index !== 8 && index !== 9);
                return filteredCells.map(cell => cell.textContent.trim());
            });

            // Generar la tabla en el PDF sin las columnas 8 y 9
            doc.autoTable({
                startY: 55,
                head: head,
                body: body,
                theme: 'grid',
                headStyles: {
                    fillColor: [0, 51, 102],
                    textColor: [255, 255, 255],
                    fontSize: 8,
                    halign: 'center',
                    fontStyle: 'bold'
                },
                bodyStyles: {
                    textColor: [0, 0, 0],
                    fontSize: 7,
                    halign: 'center',
                    cellPadding: 2
                },
                alternateRowStyles: {
                    fillColor: [240, 240, 240]
                },
                styles: {
                    lineColor: [0, 0, 0],
                    lineWidth: 0.5,
                },
                tableLineColor: [0, 0, 0],
                tableLineWidth: 0.75
            });

            // Pie de página
            doc.setFontSize(10);
            doc.text("ELABORADO POR:", 14, doc.lastAutoTable.finalY + 10);
            doc.text("Nombre: ___________________", 14, doc.lastAutoTable.finalY + 18);
            doc.text("Cargo: _____________________", 14, doc.lastAutoTable.finalY + 26);
            doc.text("Firma: _____________________", 14, doc.lastAutoTable.finalY + 34);
            doc.text("Fecha: _____________________", 14, doc.lastAutoTable.finalY + 42);

            doc.text("REVISADO POR:", 110, doc.lastAutoTable.finalY + 10);
            doc.text("Nombre: ___________________", 110, doc.lastAutoTable.finalY + 18);
            doc.text("Cargo: _____________________", 110, doc.lastAutoTable.finalY + 26);
            doc.text("Firma: _____________________", 110, doc.lastAutoTable.finalY + 34);
            doc.text("Fecha: _____________________", 110, doc.lastAutoTable.finalY + 42);

            // Guardar o mostrar PDF
            const pdfBlob = doc.output('blob');
            if (window.showSaveFilePicker) {
                const options = {
                    suggestedName: 'activos.pdf',
                    types: [{
                        description: 'PDF file',
                        accept: { 'application/pdf': ['.pdf'] },
                    }],
                };

                try {
                    const fileHandle = await window.showSaveFilePicker(options);
                    const writableStream = await fileHandle.createWritable();
                    await writableStream.write(pdfBlob);
                    await writableStream.close();
                    alert('Archivo guardado exitosamente.');
                } catch (error) {
                    alert('Error al guardar el archivo: ' + error.message);
                }
            } else {
                const link = document.createElement('a');
                link.href = URL.createObjectURL(pdfBlob);
                link.download = 'controlactivos.pdf';
                link.click();
                URL.revokeObjectURL(link.href);
            }
        }
            function cambiarTamañoPagina(size) {
            window.location.href = '@Url.Action("Index")' + '?pagina=1&pageSize=' + size;
        }

          
        // Mostrar/Ocultar acciones de funcionalidad
        document.addEventListener('DOMContentLoaded', function () {
             const toggleButton = document.getElementById('toggle-funcionalidad-column');
             const funcionalidadCeldas = document.querySelectorAll('.funcionabilidad-column');
             let visible = false;

             toggleButton.addEventListener('click', function () {
                 visible = !visible;
                 funcionalidadCeldas.forEach(celda => {
                     celda.style.display = visible ? 'table-cell' : 'none';
                 });
                 toggleButton.textContent = visible ? 'Ocultar Acciones' : 'Mostrar Acciones';
             });
         });

            $(document).on('click', '#toggle-funcionalidad-column', function () {
            const columnas = $(".funcionabilidad-column");
            const estadoActual = columnas.first().css("display") === "none";

            columnas.css("display", estadoActual ? "table-cell" : "none");
            $(this).text(estadoActual ? "Ocultar Acciones" : "Mostrar Acciones");
        });

    </script>
}
