@model InventarioPaldaca.Models.ViewModels.UsuarioPerfilViewModel

@{
    ViewBag.Title = "Buscar Usuarios";
}
@section Styles {
        <link rel="stylesheet" href="~/css/PerfilUsuario.css">
        <link rel="stylesheet"
              href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
}

<!-- Formulario de búsqueda -->
<section class="container my-5">
    <h2 class="form-title">
        <img src="/img/Iconos/usuario.svg" alt="Icono Activos" style="width: 32px; height: 32px; margin-right: 10px;">
        Perfil de Usuario
    </h2>
    <hr class="linea" />
    <div class="card">
            <div class="card-body p-4">
                <!-- Formulario de búsqueda -->
                <form id="searchForm">
                    <div class="form-group">
                        <div class="input-group">
                            <!-- Caja de búsqueda con icono -->
                            <div class="search">
                                <span class="material-symbols-outlined search-icon">Search</span>
                                <input type="search" name="searchTerm" id="searchTerm" class="form-control border-start-0 search-input"
                                       placeholder="Buscar Usuario" value="@Model.SearchTerm">
                            </div>
                            <!-- Botón de búsqueda -->
                            <div class="input-group-append">
                                <button type="button" class="btn btn-primary btn-search mt-3" id="searchBtn">Buscar</button>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
    </div>
    <!-- Mostrar usuarios encontrados -->
        <div id="usuariosEncontradosContainer" class="text-white p-4 rounded">
            <partial name="_UsuariosEncontradosPartial" model="Model" />
        </div>
    <div id="noUsersFoundMessage" class="alert alert-warning mt-3 d-none">
        No se encontraron usuarios con ese nombre.
    </div>

</section>

@section Scripts {
    <script>
        const searchBtn = document.getElementById("searchBtn");
        const searchInput = document.getElementById("searchTerm");

        function buscarUsuarios() {
            const searchTerm = searchInput.value.trim();

            fetch(`/Usuario/BuscarUsuariosIndex?searchTerm=${encodeURIComponent(searchTerm)}`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then(response => response.text())
                .then(html => {
                    const container = document.getElementById("usuariosEncontradosContainer");
                    container.innerHTML = html;

                    const noUsersFoundMessage = document.getElementById("noUsersFoundMessage");
                    if (!document.querySelector("#usuariosEncontradosContainer .list-group-item")) {
                        noUsersFoundMessage?.classList.remove("d-none");
                    } else {
                        noUsersFoundMessage?.classList.add("d-none");
                    }
                });
        }

        searchBtn.addEventListener("click", buscarUsuarios);

        searchInput.addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                buscarUsuarios();
            }
        });
    </script>
}
