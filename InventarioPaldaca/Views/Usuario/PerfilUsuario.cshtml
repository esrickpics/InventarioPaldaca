@model InventarioPaldaca.Models.ViewModels.UsuarioPerfilViewModel
@using System.IO

@{
    ViewBag.Title = "Perfil del Usuario";
}
@section Styles {
    <link rel="stylesheet" href="~/css/PerfilUsuario.css">
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
}

<!-- Enlaces de navegación -->
<a asp-area="" asp-controller="Activo" asp-action="Index" class="btn btn-success mt-3 btn-space">Ver Activos</a>

<a asp-action="Create" asp-controller="Usuario" class="btn btn-primary mt-3">Nuevo Usuario</a>

@if (Model.SolicitarRestablecer && !Model.PuedeRestablecer)
{
    <form asp-action="AutorizarRestablecer" method="post">
        <input type="hidden" name="id" value="@Model.UsuarioId" />
        <button type="submit" class="btn btn-action mt-3">
            Autorizar restablecimiento de contraseña
        </button>
    </form>
}
else if (Model.PuedeRestablecer)
{
    <span class="badge bg-success mt-3">Autorizado para restablecer contraseña</span>
}
<!-- Mensajes de éxito o error -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success mt-3">@TempData["Success"]</div> 
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mt-3">@TempData["Error"]</div>
}
<div class="container mt-5 mb-5">
    <h2 class="form-title d-flex align-items-center">
        <img src="/img/Iconos/usuario.svg" alt="Icono Activos" class="me-2" style="width: 32px; height: 32px;">
        Perfil de Usuario
    </h2>

    <!-- Buscador (NO MODIFICADO) -->
    <div class="card">
        <hr class="linea" />
        <div class="card-body cardsearch">
            <form id="searchForm">
                <div class="input-group">
                    <div class="search">
                        <span class="material-symbols-outlined search-icon">Search</span>
                        <input type="search" name="searchTerm" id="searchTerm" class="form-control border-start-0 search-input"
                               placeholder="Buscar Usuario" value="@Model.SearchTerm">
                    </div>
                    <div class="input-group-append">
                        <button type="button" class="btn btn-primary btn-search mt-2" id="searchBtn">Buscar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="usuariosEncontradosContainer">
        <partial name="_UsuariosEncontradosPartial" model="Model" />
    </div>

    <div class="text-end mt-3">
        <button id="editarBtn" class="btn btn-primary">Editar Usuario</button>
    </div>

    <!-- Contenedor del formulario con clase form-container -->
    <div class="container mt-4 p-4">
        <form asp-action="EditarUsuario" method="post" id="perfilForm" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="UsuarioId" value="@Model.UsuarioId" />

            <div class="row g-4 align-items-center">
                <!-- Foto -->
                <div class="col-lg-3 text-center">
                    <img id="userImagePreview" src="@Url.Content(string.IsNullOrEmpty(Model.UsuarioImagenUrl) ? "~/img/Usuarios/Img.default.png" : Model.UsuarioImagenUrl)" class="img-fluid rounded-circle profile-img mb-2" />
                    <input asp-for="UsuarioImagenUrl" type="file" id="userImageInput" name="userImage" accept="image/*" class="form-control d-none mt-2" />
                </div>

                <!-- Datos -->
                <div class="col-lg-5">
                    <h4 class="mb-1">
                        <span id="displayNombre">@Model.UsuarioNombre</span>
                        <input asp-for="UsuarioNombre" class="form-control d-none mb-2" />
                        <span id="displayApellido">@Model.UsuarioApellido</span>
                        <input asp-for="UsuarioApellido" class="form-control d-none mb-2" />
                    </h4>
                    <p class="text-muted mb-2">
                        <span id="displayCargo">@Model.UsuarioCargo</span>
                        <input asp-for="UsuarioCargo" class="form-control d-none" />
                    </p>
                    <p class="mb-1"><i class="fas fa-envelope me-2"></i><span id="displayCorreo">@Model.UsuarioCorreo</span></p>
                    <input asp-for="UsuarioCorreo" class="form-control d-none mb-2" />
                    <p><i class="fas fa-phone me-2"></i><span id="displayTelefono">@Model.UsuarioTelefono</span></p>
                    <input asp-for="UsuarioTelefono" class="form-control d-none" />
                </div>

                <!-- Activos -->
                <div class="col-lg-4">
                    <h5 class="fw-bold mb-3">Activos Asociados</h5>
                    @if (Model.ActivosAsociados != null && Model.ActivosAsociados.Any())
                    {
                        <div class="table-responsive" style="max-height: 250px;">
                            <table class="table table-sm table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Marca</th>
                                        <th>Modelo</th>
                                        <th>Código</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var activo in Model.ActivosAsociados)
                                    {
                                        <tr>
                                            <td>@activo.Marca</td>
                                            <td>@activo.Modelo</td>
                                            <td>@activo.CodigoInventario</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Sin activos asociados.</p>
                    }
                </div>
            </div>

            <!-- PDF -->
            <div class="row mt-4">
                <div class="col-12">
                    <label class="form-label fw-bold d-none" id="pdfHeading">Plantilla de Asignación</label>
                    <input asp-for="AsignacionPdf" type="file" id="pdfInput" name="pdfFile" accept=".pdf" class="form-control d-none" />
                    <span asp-validation-for="AsignacionPdf" class="text-danger"></span>

                    @if (!string.IsNullOrEmpty(ViewBag.ErrorMensaje))
                    {
                        <div class="alert alert-danger mt-3">@ViewBag.ErrorMensaje</div>
                    }
                    else
                    {
                        <div id="pdf-buttons" class="btn-group mt-3 d-none" role="group">
                            <a href="@Model.AsignacionPdf" target="_blank" class="btn btn-outline-success">Ver Asignación</a>
                            <a href="@Model.AsignacionPdf" download="AsignacionPDF_@($"{Model.UsuarioNombre}_{Model.UsuarioApellido}.pdf")" class="btn btn-outline-primary">Descargar</a>
                        </div>
                    }
                </div>
            </div>

            <!-- Botones -->
            <div class="text-end mt-4">
                <button type="submit" id="guardarBtn" class="btn btn-success d-none">Guardar</button>
                <button type="button" id="cancelarBtn" class="btn btn-danger d-none">Cancelar</button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Función para activar el modo de edición
            const editarBtn = document.getElementById("editarBtn");
            const cancelarBtn = document.getElementById("cancelarBtn");
            const pdfButtons = document.getElementById("pdf-buttons");
            const guardarBtn = document.getElementById("guardarBtn");
            const uploadImageGroup = document.getElementById("uploadImageGroup");

            if (editarBtn) {
                editarBtn.addEventListener("click", function () {
                    toggleEditing(true);
                });
            }

            if (cancelarBtn) {
                cancelarBtn.addEventListener("click", function () {
                    toggleEditing(false);
                });
            }

            // Función para alternar entre modo de edición y vista
            function toggleEditing(isEditing) {
                document.querySelectorAll("#perfilForm span").forEach(function (span) {
                    span.classList.toggle("d-none", isEditing);
                });
                document.querySelectorAll("#perfilForm input").forEach(function (input) {
                    input.classList.toggle("d-none", !isEditing);
                    input.style.display = isEditing ? 'block' : 'none';
                });

                const pdfHeading = document.getElementById("pdfHeading");
                const pdfInput = document.getElementById("pdfInput");

                // Ocultar los id con el boton de editar
                if (pdfHeading) {
                    pdfHeading.classList.toggle("d-none", !isEditing);
                }
                if (pdfInput) {
                    pdfInput.classList.toggle("d-none", !isEditing);
                }
                if (guardarBtn) {
                    guardarBtn.classList.toggle("d-none", !isEditing);
                }
                if (cancelarBtn) {
                    cancelarBtn.classList.toggle("d-none", !isEditing);
                }
                if (editarBtn) {
                    editarBtn.classList.toggle("d-none", isEditing);
                }

                if (pdfButtons) {
                    pdfButtons.style.display = isEditing ? "none" : "block";
                }

                // Mostrar/Ocultar el campo de carga de imagen al editar
                if (uploadImageGroup) {
                    uploadImageGroup.classList.toggle("d-none", !isEditing);
                }

                // Ocultar el mensaje de error cuando se activa la edición
                const errorMessage = document.getElementById("error-message");
                if (errorMessage) {
                    errorMessage.style.display = isEditing ? "none" : "block";
                }
            }

            // Simulación de búsqueda al presionar Enter
            const searchTermInput = document.getElementById("searchTerm");
            const searchBtn = document.getElementById("searchBtn");

            if (searchTermInput) {
                searchTermInput.addEventListener("keydown", function (event) {
                    if (event.key === "Enter") {
                        event.preventDefault();
                        searchBtn?.click();
                    }
                });
            }

            if (searchBtn) {
                searchBtn.addEventListener("click", function () {
                    var searchTerm = searchTermInput.value.trim();

                    if (!searchTerm) {
                        document.getElementById("usuariosEncontradosContainer").innerHTML = '';
                        document.getElementById("noUsersFoundMessage").classList.remove("d-none");
                        return;
                    }

                    var url = `/Usuario/PerfilUsuario?id=@Model.UsuarioId&searchTerm=${encodeURIComponent(searchTerm)}`;

                    fetch(url, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                        .then(response => response.text())
                        .then(html => {
                            var usuariosEncontradosContainer = document.getElementById("usuariosEncontradosContainer");
                            if (usuariosEncontradosContainer) {
                                usuariosEncontradosContainer.innerHTML = html;
                            }

                            var noUsersFoundMessage = document.getElementById("noUsersFoundMessage");
                            if (noUsersFoundMessage) {
                                if (!document.querySelector("#usuariosEncontradosContainer .list-group-item")) {
                                    noUsersFoundMessage.classList.remove("d-none");
                                } else {
                                    noUsersFoundMessage.classList.add("d-none");
                                }
                            }
                        });
                });
            }

            document.addEventListener("DOMContentLoaded", function () {
                const pdfInput = document.getElementById("pdfInput");
                const pdfFileNameDisplay = document.getElementById("pdfFileNameDisplay");

                // Mostrar el nombre del archivo PDF cargado
                if (pdfInput) {
                    pdfInput.addEventListener("change", function (event) {
                        const file = event.target.files[0];
                        if (file) {
                            if (file.type !== "application/pdf") {
                                alert("Por favor, selecciona un archivo PDF.");
                                event.target.value = ""; // Resetear el campo de archivo
                            } else if (pdfFileNameDisplay) {
                                pdfFileNameDisplay.textContent = "Archivo cargado: " + file.name;
                                pdfFileNameDisplay.classList.remove("d-none");
                            }
                        }
                    });
                }

                // Lógica para alternar entre modo de edición y vista
                function toggleEditing(isEditing) {
                    document.querySelectorAll("#perfilForm input").forEach(input => {
                        input.classList.toggle("d-none", !isEditing);
                    });

                    if (pdfFileNameDisplay) {
                        pdfFileNameDisplay.classList.toggle("d-none", isEditing);
                    }
                }
            });
            // Validación para el PDF asignado
            var asignacionPdf = '@Model.AsignacionPdf';
            const errorMessage = document.getElementById("error-message");

            if (asignacionPdf && asignacionPdf.trim() !== "") {
                pdfButtons.style.display = "block";
            } else if (errorMessage) {
                errorMessage.style.display = "block";
            }

            // Mostrar nombre del archivo cargado
            const pdfInput = document.getElementById("pdfInput");
            if (pdfInput) {
                pdfInput.addEventListener("change", function (event) {
                    var file = event.target.files[0];

                    if (file) {
                        if (file.type !== "application/pdf") {
                            alert("Por favor, selecciona un archivo PDF.");
                            event.target.value = ""; // Resetear el campo de archivo
                        } else {
                            var fileNameDisplay = document.getElementById("pdfFileNameDisplay");
                            if (fileNameDisplay) {
                                fileNameDisplay.textContent = file.name;
                                fileNameDisplay.classList.remove("d-none");
                            }
                        }
                    }
                });
            }
        });
    </script>
}
