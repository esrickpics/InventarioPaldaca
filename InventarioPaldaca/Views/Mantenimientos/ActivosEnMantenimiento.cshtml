@model InventarioPaldaca.Models.ViewModels.ActivosMantenimientoViewModel
@using System.Globalization


<div class="form-container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
        <h2 class="form-title" style="margin: 0;">
            <img src="/img/Iconos/Mantenimiento.svg" alt="Icono Mantenimiento" style="width: 32px; height: 32px; margin-right: 10px;">
            Activos en Mantenimiento
        </h2>
        <a asp-action="HistorialMantenimientos" asp-controller="Mantenimientos" class="btn btn-sm btn-action text-white mb-2 shadow-sm"
           style="min-width: 150px; margin-bottom: 0 !important;">
            Historial de Mantenimientos
        </a>
    </div>
    <hr class="linea" />
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Ubicación</th>
                <th>Usuario Asignado</th>
                <th>Costo</th>
                <th>Estado del Mantenimiento</th>
                <th>Descripcion</th>
                <th>Acciones</th>
            </tr>   
        </thead>
        <tbody>
        @if (!Model.Activos.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No hay activos en mantenimiento actualmente.</td>
            </tr>
        }
        else
            @foreach (var activo in Model.Activos)
            {
                var mantenimientoActual = activo.Mantenimientos
                    .Where(m => m.Estado == "En proceso")
                    .OrderByDescending(m => m.FechaInicio)
                    .FirstOrDefault();

                <tr>
                    <td>@activo.CodigoInventario</td>
                    <td>@activo.Categoria?.CategoriaNombre</td>
                    <td>@activo.Ubicacion?.UbicacionNombre</td>
                    <td>@activo.Usuario?.UsuarioNombre @activo.Usuario?.UsuarioApellido</td>
                    <td>@mantenimientoActual.Costo?.ToString("C", new System.Globalization.CultureInfo("en-US"))</td>
                    <td>
                        @if (mantenimientoActual != null)
                        {
                            <span class="badge bg-warning">En proceso desde @mantenimientoActual.FechaInicio.ToShortDateString()</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Sin mantenimiento activo</span>
                        }
                    </td>
                    <td>
                        @if (mantenimientoActual != null)
                        {
                            <span> @mantenimientoActual.Descripcion</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Sin mantenimiento activo</span>
                        }
                    </td>
                    <td>
                        @if (mantenimientoActual != null)
                        {
                            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editarMantenimientoModal-@mantenimientoActual.MantenimientoId">
                                Editar
                            </button>

                            <form asp-action="FinalizarMantenimiento" method="post" style="display:inline;">
                                <input type="hidden" name="mantenimientoId" value="@mantenimientoActual.MantenimientoId" />
                                <button type="submit" class="btn btn-sm btn-success ms-1"
                                        onclick="return confirm('¿Estás seguro de finalizar este mantenimiento?');">
                                    Finalizar
                                </button>
                            </form>

                            <!-- Modal de edición -->
                            <div class="modal fade" id="editarMantenimientoModal-@mantenimientoActual.MantenimientoId" tabindex="-1" aria-labelledby="editarMantenimientoLabel" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="EditarMantenimiento" method="post">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Editar Mantenimiento</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                            </div>
                                            <div class="modal-body">
                                                <input type="hidden" name="MantenimientoId" value="@mantenimientoActual.MantenimientoId" />
                                                <div class="mb-3">
                                                    <label class="form-label">Técnico</label>
                                                    <input type="text" name="Tecnico" value="@mantenimientoActual.Tecnico" class="form-control" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Número Técnico</label>
                                                    <input type="text" name="NumeroTecnico" value="@mantenimientoActual.NumeroTecnico" class="form-control" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Costo</label>
                                                    <input type="number" name="Costo" value="@mantenimientoActual.Costo?.ToString("0.00", CultureInfo.InvariantCulture)" step="0.01" class="form-control" required />

                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Descripción</label>
                                                    <textarea name="Descripcion" class="form-control">@mantenimientoActual.Descripcion</textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <button type="submit" class="btn btn-success">Guardar Cambios</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
   
    @{
        decimal totalCosto = 0;

        foreach (var activo in Model.Activos)
        {
            var mantenimiento = activo.Mantenimientos
            .Where(m => m.Estado == "En proceso")
            .OrderByDescending(m => m.FechaInicio)
            .FirstOrDefault();

            if (mantenimiento?.Costo != null)
            {
                totalCosto += mantenimiento.Costo.Value;
            }
        }
    }


    <div class="info-card mt-4 p-3 shadow-sm rounded d-flex justify-content-between align-items-center" style="font-size: 1.2rem;">
        <div class="d-flex align-items-center">
            <img src="~/img/Iconos/Dolar-icon.jpeg" alt="Dólar" style="width: 32px; height: 32px; margin-right: 10px;" />
            <strong>Costo total de mantenimiento</strong>
        </div>
        <span class="fs-5 fw-bold text-primary">
            $@totalCosto.ToString("0.00", CultureInfo.InvariantCulture)
        </span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
</div>
