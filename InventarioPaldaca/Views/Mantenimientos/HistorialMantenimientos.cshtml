@model InventarioPaldaca.Models.ViewModels.MantenimientoViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/Create.css">
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
}

<div class="form-container">
    <h2 class="form-title">
        <img src="/img/Iconos/Mantenimiento.svg" alt="Icono Mantenimiento" style="width: 32px; height: 32px; margin-right: 10px;">
        Historial de Mantenimientos
    </h2>
    <hr class="linea" />

    <form method="get" asp-action="HistorialMantenimientos">
        <div class="form-group">
            <label for="codigo">Buscar por Código de Inventario:</label>
            <input type="text" name="codigo" class="form-control" placeholder="Ingrese el código del activo..." value="@Model.CodigoInventarioBuscado" />
        </div>
        <div class="form-group mt-2">
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </form>

    @if (Model.MostrandoHistorial && Model.HistorialDelActivo.Any())
    {
        <hr />
        <h4>Historial del Activo: <strong>@Model.CodigoInventarioBuscado</strong></h4>
        <table class="table table-bordered table-striped mt-3">
            <thead>
                <tr>
                    <th>Fecha Inicio</th>
                    <th>Fecha Fin</th>
                    <th>Estado</th>
                    <th>Técnico</th>
                    <th>Descripción</th>
                    <th>Costo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.HistorialDelActivo)
                {
                    <tr>
                        <td>@item.FechaInicio.ToShortDateString()</td>
                        <td>@item.FechaFin?.ToShortDateString() ?? "N/A"</td>
                        <td>@item.Estado</td>
                        <td>@item.Tecnico</td>
                        <td>@item.Descripcion</td>
                        <td>@item.Costo?.ToString("C") ?? "0,00"</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (Model.MostrandoHistorial)
    {
        <p class="text-warning mt-3">No se encontraron mantenimientos para el código <strong>@Model.CodigoInventarioBuscado</strong>.</p>
    }

    <hr />
    <h4>Últimos Mantenimientos</h4>
    <table class="table table-bordered table-striped mt-3">
        <thead>
            <tr>
                <th>Código Inventario</th>
                <th>Activo</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Estado</th>
                <th>Técnico</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.UltimosMantenimientos)
            {
                <tr>
                    <td>@item.Activo.CodigoInventario</td>
                    <td>@item.Activo.Modelo</td>
                    <td>@item.Activo.Marca</td>
                    <td>@item.FechaInicio.ToShortDateString()</td>
                    <td>@item.FechaFin?.ToShortDateString() ?? "N/A"</td>
                    <td>@item.Estado</td>
                    <td>@item.Tecnico</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
