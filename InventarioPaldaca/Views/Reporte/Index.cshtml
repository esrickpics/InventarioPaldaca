@model List<InventarioPaldaca.Models.Inventario.Reporte>
@{
    ViewData["Title"] = "Reportes Generados";
}

<h2 class="mb-4">Reportes Generados</h2>

@if (Model.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Usuario</th>
                <th>Fecha de Generación</th>
                <th>Descripción</th>
                <th>Archivo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reporte in Model)
            {
                <tr>
                    <td>@reporte.ReporteId</td>
                    <td>@reporte.Usuario.UsuarioNombre</td>
                    <td>@reporte.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@reporte.Descripcion</td>
                    <td>
                        @if (!string.IsNullOrEmpty(reporte.RutaArchivo))
                        {
                            <a href="@Url.Content(reporte.RutaArchivo)" target="_blank" class="btn btn-primary btn-sm">Ver</a>
                        }
                        else
                        {
                            <span class="text-muted">No disponible</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning" role="alert">
        No hay reportes generados.
    </div>
}
