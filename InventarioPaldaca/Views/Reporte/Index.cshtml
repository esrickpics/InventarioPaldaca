@model List<InventarioPaldaca.Models.Inventario.Reporte>
@{
    ViewData["Title"] = "Reportes Generados";
}
@section styles {
    <link rel="stylesheet" href="~/css/Reportes.css" />
}

<h2 class="mb-4">Reportes</h2>

@if (Model.Any())
{
    <div class="reportes-container">
        @foreach (var reporte in Model)
        {
            <div class="reporte-card">
                <div class="reporte-fecha">
                    @reporte.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")
                </div>
                <div class="reporte-body">
                    <img src="@Url.Content(string.IsNullOrEmpty(reporte.Usuario.ImagenUrl) ? "~/img/Usuarios/Img.default.png" : reporte.Usuario.ImagenUrl)" alt="Foto del usuario" class="reporte-img" />
                    <div class="reporte-info">
                        <strong>@reporte.Usuario.UsuarioNombre</strong><br />
                        <small class="cargo">@reporte.Usuario.UsuarioCargo</small><br />
                        @if (reporte.Activo != null)
                        {
                            <small class="cargo">Activo con Código: @reporte.Activo.CodigoInventario</small>
                        }
                        else
                        {
                            <small class="cargo text-muted">Sin registro de activo</small>
                        }

                        <p class="descripcion">@reporte.Descripcion</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        No hay reportes generados.
    </div>
}

