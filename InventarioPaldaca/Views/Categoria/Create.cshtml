@model InventarioPaldaca.Models.ViewModels.CategoriaViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/Create.css">
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
}
<a asp-action="Create" asp-controller="CategoriaMaster" class="btn btn-action btn-sm mb-4">Nueva Categoria Master</a>

<a asp-action="Editar" asp-controller="Categoria" class="btn btn-action btn-sm ms-2 mb-4">
    Editar subCategoría
</a>

<div class="form-container">
    <h2 class="form-title">
        <img src="/img/Iconos/nueva-categoria.svg" alt="Icono Activos" style="width: 32px; height: 32px; margin-right: 10px;">
        Nueva Categoria
    </h2>
    <hr class="linea" />
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger">
            </div>

            <div class="form-group">
                <label asp-for="CategoriaNombre"></label>
                <input asp-for="CategoriaNombre" class="form-control" />
                <span asp-validation-for="CategoriaNombre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CategoriaDescripcion"></label>
                <textarea asp-for="CategoriaDescripcion" class="form-control"></textarea>
                <span asp-validation-for="CategoriaDescripcion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CategoriaMasterId">Categoría Master</label>
                <select asp-for="CategoriaMasterId" class="form-control" asp-items="Model.CategoriasMasterDisponibles">
                    <option value="">-- Seleccione una categoría master --</option>
                </select>
                <span asp-validation-for="CategoriaMasterId" class="text-danger"></span>
            </div>

            <hr />
            <div class="form-group">
                <input type="submit" value="Crear" class="btn btn-primary" />
            </div>
        </form>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
