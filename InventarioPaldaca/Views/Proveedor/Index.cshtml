@model InventarioPaldaca.Models.ViewModels.ProveedorViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/PerfilUsuario.css">
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
}
<section class="container form-container mt-5 mb-5">
    <h2 class="form-title">
        <img src="/img/Iconos/proveedor.svg" alt="Icono Proveedor" style="width: 32px; height: 32px; margin-right: 10px;">
        Proveedores
    </h2>
    <div class="card">
        <hr class="linea" />
        <div class="card-body cardsearch">
            <!-- Formulario de búsqueda -->
            <form id="searchFormProveedor" onsubmit="event.preventDefault();">
                <div class="form-group">
                    <div class="input-group">
                        <!-- Caja de búsqueda con icono -->
                        <div class="search">
                            <span class="material-symbols-outlined search-icon">Search</span>
                            <input type="search" id="searchTermProveedor" class="form-control border-start-0 search-input"
                                   placeholder="Buscar Proveedor" />
                        </div>
                        <!-- Botón de búsqueda -->
                        <div class="input-group-append">
                            <button type="button" class="btn btn-primary btn-search mt-2" id="searchBtnProveedor">Buscar</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div id="proveedoresEncontradosContainer" class="text-white p-4 rounded">
        <partial name="_ProveedoresEncontradosPartial" model="Model" />
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById("searchTermProveedor").addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                document.getElementById("searchBtnProveedor").click(); // Simular clic en el botón de búsqueda
            }
        });

        document.getElementById("searchBtnProveedor").addEventListener("click", function () {
            var searchTerm = document.getElementById("searchTermProveedor").value.trim();

            if (!searchTerm) {
                // Si el campo de búsqueda está vacío, no realizar la solicitud
                document.getElementById("proveedoresEncontradosContainer").innerHTML = '';
                document.getElementById("noProvidersFoundMessage").classList.remove("d-none");
                return;
            }

            var url = `/Proveedor/BuscarProveedores?searchTerm=${encodeURIComponent(searchTerm)}`;

            fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then(response => response.text())
                .then(html => {
                    var proveedoresEncontradosContainer = document.getElementById("proveedoresEncontradosContainer");
                    proveedoresEncontradosContainer.innerHTML = html;

                    var noProvidersFoundMessage = document.getElementById("noProvidersFoundMessage");
                    if (!document.querySelector("#proveedoresEncontradosContainer .list-group-item")) {
                        noProvidersFoundMessage.classList.remove("d-none");
                    } else {
                        if (noProvidersFoundMessage) {
                            noProvidersFoundMessage.classList.add("d-none");
                        }
                    }
                });
        });
    </script>
}
