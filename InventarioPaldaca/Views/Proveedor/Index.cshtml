@model InventarioPaldaca.Models.ViewModels.ProveedorViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/PerfilUsuario.css">
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
}
<!-- Contenedor superior con precio del dólar y botón de nuevo proveedor -->
<div class="d-flex justify-content-between align-items-center flex-wrap mb-4 px-3">
    <div class="alert alert-info py-2 px-4 mb-2 shadow-sm rounded" style="background-color: #f0f8ff;">
        <strong>Precio del dólar oficial (VES):</strong>
        @if (ViewBag.PrecioDolar != null)
        {
            @ViewBag.PrecioDolar
        }
        else
        {
            <span>No se pudo obtener el precio del dólar.</span>
        }
    </div>

    <a asp-controller="Proveedor" asp-action="Create" class="btn btn-sm btn-action text-white mb-2 shadow-sm"
       style="min-width: 150px;">
        Nuevo Proveedor
    </a>
</div>

<section class="container form-container mt-5 mb-5">
   

    <h2 class="form-title">
        <img src="/img/Iconos/proveedor.svg" alt="Icono Proveedor" style="width: 32px; height: 32px; margin-right: 10px;">
        Proveedores
    </h2>
    
  
    <div class="card">
        <hr class="linea" />
        <div class="card-body cardsearch">
            <!-- Formulario de búsqueda -->
            <form id="searchFormProveedor" onsubmit="event.preventDefault();">
                <div class="form-group">
                    <div class="input-group">
                        <!-- Caja de búsqueda con icono -->
                        <div class="search">
                            <span class="material-symbols-outlined search-icon">Search</span>
                            <input type="search" id="searchTermProveedor" class="form-control border-start-0 search-input"
                                   placeholder="Buscar Proveedor" />
                        </div>
                        <!-- Botón de búsqueda -->
                        <div class="input-group-append">
                            <button type="button" class="btn btn-primary btn-search mt-2" id="searchBtnProveedor">Buscar</button>
                        </div>
                    </div>
                </div>
                <div class="filter-container mb-4 mt-4">
                    <h5 class="form-title" style="font-size: 20px;">
                        <img src="/img/Iconos/filtrar.svg" alt="Icono Activos" style="width: 32px; height: 32px; margin-right: 10px;">
                        Filtrar Proveedores
                    </h5>
                    <!-- Filtro de Categoría Maestra -->
                    <div class="form-group mt-3">
                        
                        <select class="form-select" id="categoriaMasterFilter">
                            <option value="">Seleccione una Categoría</option>
                            @foreach (var categoriaMaster in Model.CategoriasMaestras)
                            {
                                <option value="@categoriaMaster.CategoriaMasterId">@categoriaMaster.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
            </form>
        </div>
    </div>
    
    <div id="proveedoresEncontradosContainer" class="text-white p-4 rounded">
        <partial name="_ProveedoresEncontradosPartial" model="Model.ProveedoresEncontrados" />
    </div>

    <!-- Modal para editar proveedor -->
    <div class="modal fade" id="editarProveedorModal" tabindex="-1" aria-labelledby="editarProveedorModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editarProveedorModalLabel">Editar Proveedor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="modalBodyEditarProveedor">
                    <!-- Aquí se cargará el formulario por AJAX -->
                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    <script>
        // Función para realizar la búsqueda o filtrar por categoría maestra
        function buscarProveedores() {
            var searchTerm = document.getElementById("searchTermProveedor").value.trim();
            var categoriaMasterId = document.getElementById("categoriaMasterFilter").value;

            var url = `/Proveedor/BuscarProveedores?searchTerm=${encodeURIComponent(searchTerm)}&categoriaMasterId=${encodeURIComponent(categoriaMasterId)}`;

            fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.text())
            .then(html => {
                document.getElementById("proveedoresEncontradosContainer").innerHTML = html;
            });
        }

        // Escucha del botón de búsqueda
        document.getElementById("searchBtnProveedor").addEventListener("click", function () {
            buscarProveedores();
        });

        // Escucha para la entrada de búsqueda (presionar Enter)
        document.getElementById("searchTermProveedor").addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                buscarProveedores();
            }
        });

        // Escucha para el cambio de la categoría maestra en el filtro
        document.getElementById("categoriaMasterFilter").addEventListener("change", function () {
            buscarProveedores();
        });
        const modal = document.getElementById('editarProveedorModal');

        modal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const proveedorId = button.getAttribute('data-id');

            fetch(`/Proveedor/EditPartial?id=${proveedorId}`)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('modalBodyEditarProveedor').innerHTML = html;

                    // Después de cargar el formulario, engancha el submit para AJAX
                    const form = document.getElementById('formEditarProveedor');

                    form.addEventListener('submit', function (e) {
                        e.preventDefault();

                        const formData = new FormData(form);

                        // Obtener el token antifalsificación
                        const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

                        fetch('/Proveedor/EditModal', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            },
                            body: formData
                        })
                        .then(response => {
                            if (response.ok) {
                                // Cerrar modal y mostrar mensaje
                                const bootstrapModal = bootstrap.Modal.getInstance(modal);
                                bootstrapModal.hide();
                                alert("Proveedor actualizado correctamente.");
                                // Aquí puedes refrescar datos en la tabla o UI
                            } else {
                                response.json().then(data => {
                                    alert("Error al guardar: " + (data.mensaje || "Error desconocido"));
                                    console.error(data.errores);
                                });
                            }
                        })
                        .catch(err => {
                            alert("Error al guardar los datos.");
                            console.error(err);
                        });
                    });
                });
        }); 
        //ELiminar
               document.addEventListener('DOMContentLoaded', function () {
            // Delegación de evento para botones eliminar (si el partial se recarga)
            document.body.addEventListener('click', function (e) {
                if (e.target.classList.contains('btnEliminarProveedor')) {
                    const proveedorId = e.target.getAttribute('data-id');

                    if (confirm('¿Estás seguro de eliminar este proveedor?')) {
                        // Crear un FormData para enviar los datos como formulario
                        const formData = new FormData();
                        formData.append("id", proveedorId);
                        formData.append("__RequestVerificationToken", getAntiForgeryToken());

                        fetch('/Proveedor/Delete', {
                            method: 'POST',
                            body: formData
                        })
                        .then(res => {
                            if (res.ok) {
                                // Remover fila de la tabla
                                const row = document.getElementById(`proveedorRow_${proveedorId}`);
                                if (row) row.remove();
                                alert('Proveedor eliminado correctamente.');
                            } else {
                                alert('Error al eliminar proveedor.');
                            }
                        })
                        .catch(err => {
                            alert('Error al eliminar proveedor.');
                            console.error(err);
                        });
                    }
                }
            });
        });

        // Función para obtener el token antiforgery de la página
        function getAntiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }



        // (Opcional) Función para recargar solo la lista de proveedores:
        
    </script>
}
