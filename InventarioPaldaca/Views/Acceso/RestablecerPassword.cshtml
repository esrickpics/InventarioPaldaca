@model InventarioPaldaca.Models.ViewModels.RestablecerPasswordViewModel

@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="form-container mt-5">
    <h2>Restablecer Contraseña</h2>
    <form asp-action="RestablecerPassword" method="post">

        <input type="hidden" asp-for="UsuarioId" />

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" placeholder="Nueva contraseña" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmarPassword"></label>
            <input asp-for="ConfirmarPassword" class="form-control" placeholder="Confirmar contraseña" />
            <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-action mt-3">Restablecer</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
