@model InventarioPaldaca.Models.ViewModels.RegistroViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/styleslogin.css" asp-append-version="true" />

}
@{
    ViewData["Title"] = "Registro";
}

<div class="login">
    <div class="login__content">
        <div class="login__img">
            <img src="~/img/paldacalogin.png" alt="">
        </div>

        <div class="login__forms">
            <form asp-action="Registro" asp-controller="Acceso" class="login__registre" method="post">
                <h1 class="login__title">Crear Cuenta</h1>

                <div class="login__box">
                    <i class='bx bx-user login__icon'></i>
                    <input asp-for="Nombre" type="text" placeholder="Nombre" class="login__input">
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="login__box">
                    <i class='bx bx-user login__icon'></i>
                    <input asp-for="Apellido" type="text" placeholder="Apellido" class="login__input">
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>

                <div class="login__box">
                    <i class='bx bx-at login__icon'></i>
                    <input asp-for="Email" type="text" placeholder="Correo" class="login__input">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="login__box">
                    <i class='bx bx-lock login__icon'></i>
                    <input asp-for="Password" type="password" placeholder="Contraseña" class="login__input">
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="login__box">
                    <i class='bx bx-lock-alt login__icon'></i>
                    <input asp-for="ConfirmarPassword" type="password" placeholder="Confirmar Contraseña" class="login__input">
                    <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="login__button">Registrarse</button>
                <hr />   
                <div>
                    <span class="login__account">¿Ya tienes una cuenta?</span>
                    <a asp-action="Login" class="login__signin">Iniciar Sesión</a>
                </div>
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }
            </form>
        </div>
    </div>
</div>

