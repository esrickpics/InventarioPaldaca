@model InventarioPaldaca.Models.ViewModels.AccesoViewModel

<form asp-action="Registro" method="post">
    <div>
        <label>Nombre</label>
        <input asp-for="Nombre" />
        <span asp-validation-for="Nombre"></span>
    </div>
    <div>
        <label>Apellido</label>
        <input asp-for="Apellido" />
        <span asp-validation-for="Apellido"></span>
    </div>
    <div>
        <label>Correo</label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div>
        <label>Teléfono</label>
        <input asp-for="Telefono" />
        <span asp-validation-for="Telefono"></span>
    </div>
    <div>
        <label>Cargo</label>
        <input asp-for="Cargo" />
        <span asp-validation-for="Cargo"></span>
    </div>
    <div>
        <label>Contraseña</label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password"></span>
    </div>
    <div>
        <label>Confirmar Contraseña</label>
        <input asp-for="ConfirmarPassword" type="password" />
        <span asp-validation-for="ConfirmarPassword"></span>
    </div>
    <button type="submit">Registrarse</button>
</form>





